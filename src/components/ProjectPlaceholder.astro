---
// Theme-aware fallback artwork for projects without an image or video.
// Inline SVG so fills follow the CSS theme tokens when the toggle flips.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = `ph-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1200 675"
  preserveAspectRatio="xMidYMid slice"
  class={className}
  role="img"
  aria-hidden="true"
>
  <defs>
    <pattern id={`${uid}-dots`} width="28" height="28" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.5" style="fill: var(--color-text-muted); opacity: 0.25;"/>
    </pattern>
    <radialGradient id={`${uid}-glow`} cx="0.5" cy="0.5" r="0.55">
      <stop offset="0" stop-color="var(--color-accent-blue-dim)"/>
      <stop offset="1" stop-color="transparent"/>
    </radialGradient>
  </defs>

  <rect width="1200" height="675" style="fill: var(--color-bg-secondary);"/>
  <rect width="1200" height="675" fill={`url(#${uid}-dots)`}/>
  <rect width="1200" height="675" fill={`url(#${uid}-glow)`}/>

  <text
    x="600"
    y="337.5"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="'JetBrains Mono', monospace"
    font-size="170"
    font-weight="500"
    style="fill: var(--color-text-muted); opacity: 0.55;"
  >&gt;_</text>
</svg>
