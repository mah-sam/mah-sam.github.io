---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  image?: string;
  video?: string;
  date?: Date;
  github?: string;
  live?: string;
  link?: string;
  linkLabel?: string;
  link2?: string;
  link2Label?: string;
  compact?: boolean;
}

import CardLinks from './CardLinks.astro';

const { title, description, tags = [], image, video, date, github, live, link, linkLabel, link2, link2Label, compact = false } = Astro.props;
const year = date ? new Date(date).getFullYear() : undefined;
const hasMedia = !!(video || image);
const hasBody = Astro.slots.has('default');
const mediaClass = "w-full object-cover transition-transform duration-500 group-hover:scale-105 " + (compact ? "h-full sm:h-48" : "h-36 sm:h-48");

const links = [
  github && { href: github, label: 'Source', icon: 'github' },
  live && { href: live, label: 'Live', icon: 'external' },
  link && { href: link, label: linkLabel || 'Info', icon: 'external' },
  link2 && { href: link2, label: link2Label || 'Info', icon: 'external' },
].filter(Boolean) as { href: string; label: string; icon: string }[];
// With 2+ links the row doesn't fit beside the media on phone, so it breaks
// out to a full-width line at the bottom of the compact card instead.
const breakout = compact && links.length >= 2;
---

<div
  class:list={["glass-card overflow-hidden group", compact && "flex flex-row flex-wrap items-center gap-x-3 gap-y-1.5 p-3 sm:flex-col sm:items-stretch sm:gap-0 sm:p-0"]}
  data-modal-card
  data-modal-title={title}
  role="button"
  tabindex="0"
  aria-label={`View details: ${title}`}
>
  {hasMedia && (
    <div class:list={["overflow-hidden", compact ? "shrink-0 w-[12.4rem] max-w-[50%] aspect-video rounded-lg sm:w-full sm:max-w-none sm:aspect-auto sm:rounded-none" : ""]}>
      {video ? (
        <video
          src={video}
          data-card-video
          class={mediaClass}
          muted
          loop
          playsinline
          preload="auto"
          aria-label={title}
        ></video>
      ) : (
        <img
          src={image}
          alt={title}
          class={mediaClass}
          loading="lazy"
        />
      )}
    </div>
  )}
  <div class:list={["flex-1 min-w-0", compact ? (breakout ? "p-0 sm:px-5 sm:pt-5" : "p-0 sm:p-5") : "p-4 sm:p-5"]}>
    <div class="flex items-start justify-between gap-3 mb-1.5 sm:mb-2">
      <h3 class:list={[compact ? "text-sm sm:text-lg" : "text-base sm:text-lg", "font-semibold"]}>{title}</h3>
      {year && (
        <span class:list={["shrink-0 font-mono text-[0.65rem] sm:text-xs text-[var(--color-text-muted)] mt-0.5 sm:mt-1", compact && "hidden sm:inline"]}>{year}</span>
      )}
    </div>
    <p class:list={["text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed", compact ? "hidden sm:line-clamp-3 sm:mb-4" : "line-clamp-3 mb-3 sm:mb-4"]}>{description}</p>

    {tags.length > 0 && (
      <div class:list={[compact ? "hidden sm:flex" : "flex", "flex-wrap gap-1 mb-3 sm:mb-4"]}>
        {tags.map((tag) => (
          <span class="tech-badge text-[0.6rem] sm:text-[0.65rem] px-1.5 py-0.5">{tag}</span>
        ))}
      </div>
    )}

    {!breakout && (links.length > 0 || (compact && year)) && (
      <div class="flex items-center gap-3">
        <CardLinks links={links} year={year} showYearOnPhone={compact} />
      </div>
    )}
  </div>

  {breakout && (
    <div class="w-full flex items-center justify-center flex-wrap gap-3 sm:justify-start sm:px-5 sm:pb-5">
      <CardLinks links={links} year={year} showYearOnPhone={true} />
    </div>
  )}

  <template data-card-detail>
    {video ? (
      <video src={video} class="w-full rounded-xl mb-4" muted loop playsinline preload="metadata" aria-label={title}></video>
    ) : image && (
      <img src={image} alt={title} class="w-full rounded-xl mb-4" loading="lazy" />
    )}
    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="text-lg sm:text-xl font-semibold">{title}</h3>
      {year && (
        <span class="shrink-0 font-mono text-xs text-[var(--color-text-muted)] mt-1">{year}</span>
      )}
    </div>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mb-4">
        {tags.map((tag) => (
          <span class="tech-badge text-[0.65rem] px-1.5 py-0.5">{tag}</span>
        ))}
      </div>
    )}
    <div class="prose text-sm sm:text-base mb-5">
      {hasBody ? <slot /> : <p>{description}</p>}
    </div>
    {links.length > 0 && (
      <div class="flex items-center gap-4">
        {links.map(({ href, label, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent-blue)] transition-colors font-mono"
          >
            {icon === 'github' ? (
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            )}
            {label}
          </a>
        ))}
      </div>
    )}
  </template>
</div>

<script>
  // Gate card-video playback to the viewport (files still download eagerly via preload="auto").
  const setup = () => {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-card-video]');
    if (!videos.length) return;

    // Respect users who prefer reduced motion: keep videos paused on their first frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.25 },
    );

    videos.forEach((v) => io.observe(v));
  };

  setup();
</script>
