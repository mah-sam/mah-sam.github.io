---
// A CV link (/fai, /ais, /ee...) opens its PDF straight away. The script runs in
// <head>, before anything is drawn, so the page itself is never seen; the meta
// refresh covers browsers without JS. The links and their PDFs are listed in
// src/cv-links.mjs.
import { cvs } from '../cv-links.mjs';

interface Props {
  slug: string;
}

const cv = cvs.find(({ slug }) => slug === Astro.props.slug);
if (!cv) throw new Error(`No CV is listed for /${Astro.props.slug} in src/cv-links.mjs`);

const pdf = `/${cv.slug}/${cv.file}`;
const title = cv.lang === 'ar' ? 'محمود سامح | السيرة الذاتية' : 'Mahmoud Sameh CV';
---
<!doctype html>
<html lang={cv.lang} dir={cv.lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <script is:inline define:vars={{ pdf }}>location.replace(pdf);</script>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${pdf}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(pdf, Astro.site)} />
    <title>{title}</title>
  </head>
  <body></body>
</html>
