---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Collect all unique tags
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<PageLayout title="Projects" description="A collection of projects showcasing my engineering and AI work.">
  <!-- Header -->
  <section class="pt-24 sm:pt-32 pb-4 sm:pb-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="scroll-reveal">
        <SectionHeading
          title="Projects"
          subtitle="A collection of diverse and innovative creations, showcasing my passion for building and problem-solving."
        />
      </div>

      <!-- Filter tags -->
      <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6 sm:mb-8 scroll-reveal overflow-x-auto" id="filter-bar">
        <button
          class="filter-btn filter-active px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-xs sm:text-sm font-mono transition-all border whitespace-nowrap"
          data-filter="all"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            class="filter-btn px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-xs sm:text-sm font-mono transition-all border border-[var(--color-border)] text-[var(--color-text-muted)] whitespace-nowrap"
            data-filter={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="pb-12 sm:pb-20 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Publications cross-link -->
      <a href="/publications" class="scroll-reveal glass-card group block mb-6 sm:mb-8 p-5 sm:p-6">
        <div class="flex items-center gap-4 sm:gap-5">
          <div
            class="shrink-0 flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl"
            style="background: var(--color-accent-violet-dim); color: var(--color-accent-violet);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-mono text-[0.7rem] sm:text-xs uppercase tracking-wider mb-1" style="color: var(--color-accent-violet);">Beyond code</p>
            <h3 class="text-base sm:text-lg font-semibold text-[var(--color-text-primary)] leading-snug">I also publish peer-reviewed research</h3>
            <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] mt-0.5">Work in AI, computer vision, and applied machine learning.</p>
          </div>
          <span class="hidden sm:inline-flex items-center gap-2 font-mono text-sm text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent-violet)] transition-colors whitespace-nowrap">
            View publications
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </div>
      </a>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="projects-grid">
        {projects.map((project) => (
          <div class="scroll-reveal project-item" data-tags={project.data.tags.join(',')}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              image={project.data.image}
              video={project.data.video}
              date={project.data.date}
              github={project.data.github}
              live={project.data.live}
              link={project.data.link}
              linkLabel={project.data.linkLabel}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter!;

      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('filter-active');
      });
      btn.classList.add('filter-active');

      // Filter projects
      projectItems.forEach((item) => {
        const tags = (item as HTMLElement).dataset.tags || '';
        if (filter === 'all' || tags.includes(filter)) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
