---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection, render } from 'astro:content';

const allProjects = await getCollection('projects');
// Newest year first; within the same year, the custom `order` field decides
// (falling back to newest date when orders tie).
const sorted = allProjects.sort((a, b) => {
  const byYear = b.data.date.getFullYear() - a.data.date.getFullYear();
  if (byYear !== 0) return byYear;
  const byOrder = a.data.order - b.data.order;
  if (byOrder !== 0) return byOrder;
  return b.data.date.getTime() - a.data.date.getTime();
});
// Pre-render each project's markdown body for the detail modal
const projects = await Promise.all(
  sorted.map(async (project) => ({
    project,
    Content: project.body?.trim() ? (await render(project)).Content : null,
  }))
);

// Collect all unique tags
const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
---

<PageLayout title="Projects" description="A collection of projects showcasing my engineering and AI work.">
  <!-- Header -->
  <section class="pt-24 sm:pt-32 pb-4 sm:pb-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="scroll-reveal">
        <SectionHeading title="Projects" />
      </div>

      <!-- Filter tags -->
      <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6 sm:mb-8 scroll-reveal overflow-x-auto" id="filter-bar">
        <button
          class="filter-btn filter-active px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-xs sm:text-sm font-mono transition-all border whitespace-nowrap"
          data-filter="all"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            class="filter-btn px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-xs sm:text-sm font-mono transition-all border border-[var(--color-border)] text-[var(--color-text-muted)] whitespace-nowrap"
            data-filter={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="pb-12 sm:pb-20 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Publications cross-link note -->
      <p class="scroll-reveal mb-5 sm:mb-6 font-mono text-xs sm:text-sm text-[var(--color-text-muted)]">
        I also publish peer-reviewed research.
        <a href="/publications" class="text-[var(--color-text-secondary)] underline underline-offset-4 decoration-[var(--color-border-hover)] hover:text-[var(--color-accent-violet)] hover:decoration-[var(--color-accent-violet)] transition-colors">View publications</a>
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="projects-grid">
        {projects.map(({ project, Content }) => {
          const props = {
            title: project.data.title,
            description: project.data.description,
            tags: project.data.tags,
            image: project.data.image,
            video: project.data.video,
            date: project.data.date,
            github: project.data.github,
            live: project.data.live,
            link: project.data.link,
            linkLabel: project.data.linkLabel,
            link2: project.data.link2,
            link2Label: project.data.link2Label,
            compact: true,
          };
          return (
            <div class="scroll-reveal project-item" data-tags={project.data.tags.join(',')}>
              {Content ? (
                <ProjectCard {...props}><Content /></ProjectCard>
              ) : (
                <ProjectCard {...props} />
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter!;

      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('filter-active');
      });
      btn.classList.add('filter-active');

      // Filter projects
      projectItems.forEach((item) => {
        const tags = (item as HTMLElement).dataset.tags || '';
        if (filter === 'all' || tags.includes(filter)) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
